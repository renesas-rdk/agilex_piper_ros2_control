<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ROS 2 Control macro for Agilex Piper arm
    This macro adds ros2_control tags to the robot description
    Supports both real hardware and mock hardware configurations
  -->

  <xacro:macro name="agilex_piper_ros2_control" params="
    name:=agilex_piper_arm
    can_interface:=can0
    use_mock_hardware:=false
    include_gripper:=true
    prefix:=''
    ">

    <ros2_control name="${prefix}${name}" type="system" rw_rate="100">

      <!-- Hardware interface plugin chosen conditionally -->
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>agilex_piper_ros2_control/AgilexPiperHardwareInterface</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="include_gripper">${include_gripper}</param>
        </xacro:unless>
      </hardware>

      <!-- Joint definitions -->
      <joint name="${prefix}joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Gripper definitions (conditional) -->
      <xacro:if value="${include_gripper}">
        <joint name="${prefix}joint7">
          <command_interface name="position"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="${prefix}joint8">
          <command_interface name="position"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
    </ros2_control>

  </xacro:macro>

</robot>
