<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ROS 2 Control macro for Agilex Piper arm
    This macro adds ros2_control tags to the robot description
    Supports both real hardware and mock hardware configurations
  -->

  <xacro:macro name="agilex_piper_ros2_control" params="
    name:=agilex_piper_arm
    can_interface:=can0
    use_mock_hardware:=false
    include_gripper:=true
    prefix:=''
    ">

    <ros2_control name="${prefix}${name}" type="system" rw_rate="100">

      <!-- Hardware interface plugin chosen conditionally -->
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>agilex_piper_ros2_control/AgilexPiperHardwareInterface</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="include_gripper">${include_gripper}</param>
        </xacro:unless>
      </hardware>

      <!-- Joint definitions -->
      <joint name="${prefix}joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Gripper definitions (conditional) -->
      <xacro:if value="${include_gripper}">
        <joint name="${prefix}joint7">
          <command_interface name="position"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="${prefix}joint8">
          <command_interface name="position"/>
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>

      <!-- GPIO interfaces for extended arm features -->
      <!-- Administrative control GPIO -->
      <gpio name="${prefix}arm_admin">
        <command_interface name="enable_arm"/>
        <state_interface name="enable_arm"/>
        <state_interface name="connected"/>
      </gpio>

      <!-- End effector pose feedback GPIO -->
      <gpio name="${prefix}arm_current_pose">
        <state_interface name="x"/>
        <state_interface name="y"/>
        <state_interface name="z"/>
        <state_interface name="rx"/>
        <state_interface name="ry"/>
        <state_interface name="rz"/>
      </gpio>

      <!-- Target pose commands GPIO (Cartesian mode only) -->
      <gpio name="${prefix}arm_target_pose">
        <command_interface name="x"/>
        <command_interface name="y"/>
        <command_interface name="z"/>
        <command_interface name="rx"/>
        <command_interface name="ry"/>
        <command_interface name="rz"/>
      </gpio>

      <!-- Comprehensive status monitoring GPIO -->
      <gpio name="${prefix}arm_status">
        <state_interface name="ctrl_mode"/>
        <state_interface name="arm_status"/>
        <state_interface name="mode_feed"/>
        <state_interface name="teach_status"/>
        <state_interface name="motion_status"/>
        <state_interface name="trajectory_num"/>
        <state_interface name="err_code_comm"/>
        <state_interface name="err_code_angle"/>
      </gpio>

      <!-- Motion mode control GPIO -->
      <gpio name="${prefix}arm_motion_mode">
        <command_interface name="mode"/>
        <command_interface name="speed"/>
        <state_interface name="mode"/>
        <state_interface name="speed"/>
      </gpio>

    </ros2_control>

  </xacro:macro>

</robot>
