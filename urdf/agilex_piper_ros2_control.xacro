<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ROS 2 Control macro for Agilex Piper arm
    This macro adds ros2_control tags to the robot description
    Supports both real hardware and mock hardware configurations
  -->

  <!-- Shared joint interface definitions -->
  <xacro:macro name="piper_joint_interfaces">
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Gripper interface definitions -->
  <xacro:macro name="piper_gripper_interfaces">
    <!-- Both joints need to be controlled for proper visualization -->
    <joint name="joint7">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint8">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="agilex_piper_ros2_control" params="
    name:=AgilexPiperSystem
    can_interface:=can0
    use_mock_hardware:=false
    include_gripper:=true">

    <!-- Real hardware configuration -->
    <xacro:unless value="${use_mock_hardware}">
      <ros2_control name="${name}" type="system" rw_rate="100">
        <hardware>
          <plugin>agilex_piper_ros2_control/AgilexPiperHardwareInterface</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="include_gripper">${include_gripper}</param>
        </hardware>

        <!-- Joint interfaces -->
        <xacro:piper_joint_interfaces/>

        <!-- Gripper interfaces (conditional) -->
        <xacro:if value="${include_gripper}">
          <xacro:piper_gripper_interfaces/>
        </xacro:if>

      </ros2_control>
    </xacro:unless>

    <!-- Mock hardware configuration -->
    <xacro:if value="${use_mock_hardware}">
      <ros2_control name="${name}MockSystem" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>

        <!-- Joint interfaces -->
        <xacro:piper_joint_interfaces/>

        <!-- Gripper interfaces (conditional) -->
        <xacro:if value="${include_gripper}">
          <xacro:piper_gripper_interfaces/>
        </xacro:if>

      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>
